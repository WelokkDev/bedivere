# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Run archives (regenerable, deterministic)
runs/

# Authoring notes. Kept out of git AND out of the sdist — hatchling's default
# file selection follows this file, so an ignore here closes both paths.
prompt-*.md

# Market data. Bars are large, usually licensed, and never belong in a repo.
# README walks you into exactly these paths, so they are ignored up front.
# Anchored to the root: a bare `data/` would also swallow src/bedivere/data/.
/data/
*.csv
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Vendor archives. Large and licensed, but they are the provenance root of
# every lake partition derived from them — keep them locally, never in git.
*.dbn
*.dbn.zst

# Secrets
.env
.env.*
